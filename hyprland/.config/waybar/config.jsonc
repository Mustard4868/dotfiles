//   █     █░ ▄▄▄     ▓██   ██▓ ▄▄▄▄    ▄▄▄       ██▀███
//  ▓█░ █ ░█░▒████▄    ▒██  ██▒▓█████▄ ▒████▄    ▓██ ▒ ██▒
//  ▒█░ █ ░█ ▒██  ▀█▄   ▒██ ██░▒██▒ ▄██▒██  ▀█▄  ▓██ ░▄█ ▒
//  ░█░ █ ░█ ░██▄▄▄▄██  ░ ▐██▓░▒██░█▀  ░██▄▄▄▄██ ▒██▀▀█▄
//  ░░██▒██▓  ▓█   ▓██▒ ░ ██▒▓░░▓█  ▀█▓ ▓█   ▓██▒░██▓ ▒██▒
//  ░ ▓░▒ ▒   ▒▒   ▓▒█░  ██▒▒▒ ░▒▓███▀▒ ▒▒   ▓▒█░░ ▒▓ ░▒▓░
//    ▒ ░ ░    ▒   ▒▒ ░▓██ ░▒░ ▒░▒   ░   ▒   ▒▒ ░  ░▒ ░ ▒░
//    ░   ░    ░   ▒   ▒ ▒ ░░   ░    ░   ░   ▒     ░░   ░
//      ░          ░  ░░ ░      ░            ░  ░   ░
//                     ░ ░           ░
{
  "layer": "top",
  "spacing": 2,
  "width": "",
  "height": "",

  "modules-left": [
    "custom/sysinfo",
    "custom/separator",
    "custom/scrolling"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "battery",
    "custom/separator",
    "custom/weather",
    "clock",
  ],

  "custom/separator": {
    "format": "‎", //empty character
  },

  "custom/scrolling": {
    "exec": "/home/nynke/.config/waybar/scripts/scroll-title.sh",
    "return-type": "plain",
    "format": "{}",
  },

  "custom/weather": {
    //first fetch location using ipinfo.io, then fetch weather with wttr.in
    "exec": "city=$(curl -s 'https://ipinfo.io/city'); curl -s \"https://wttr.in/${city}?format=1\" | tr -s ' '",
    "return-type": "plain",
    "format": "{}",
    "interval": 1800,
    "tooltip": "false",
  },

  "hyprland/window": {
    "format": "{title}",
    "rewrite": {
      "": "Desktop",
      "~": "kitty",
      "^(.{30}).+$": "$1...",
    },
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "empty": "",
      "default": "",
      "active": "",
    },
    "persistent-workspaces": {
      "*": 3,
    },
  },

  "custom/sysinfo": {
    "format": " ",
    "on-click": "kitty -e --hold hyfetch",
    "tooltip": "true",
    "exec": "uname -sr",
    "tooltip-format": "{}",
    "interval": "once"
  },

  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery!'",
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂄", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰂄 {capacity}%",
    "tooltip": "true",
    "tooltip-format": "Discharging:\n{time} Remaining.",
    "tooltip-format-charging": "Charging:\n{time} Until Full.",
    "tooltip-format-full": "Finished Charging.",
  },

  "clock": {
    "format": "{:%H:%M} ",
    "tooltip": "true",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "firefox --new-tab 'https://calendar.proton.me'",
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    "on-click": "pavucontrol",
  },
}
