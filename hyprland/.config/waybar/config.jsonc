//   █     █░ ▄▄▄     ▓██   ██▓ ▄▄▄▄    ▄▄▄       ██▀███
//  ▓█░ █ ░█░▒████▄    ▒██  ██▒▓█████▄ ▒████▄    ▓██ ▒ ██▒
//  ▒█░ █ ░█ ▒██  ▀█▄   ▒██ ██░▒██▒ ▄██▒██  ▀█▄  ▓██ ░▄█ ▒
//  ░█░ █ ░█ ░██▄▄▄▄██  ░ ▐██▓░▒██░█▀  ░██▄▄▄▄██ ▒██▀▀█▄
//  ░░██▒██▓  ▓█   ▓██▒ ░ ██▒▓░░▓█  ▀█▓ ▓█   ▓██▒░██▓ ▒██▒
//  ░ ▓░▒ ▒   ▒▒   ▓▒█░  ██▒▒▒ ░▒▓███▀▒ ▒▒   ▓▒█░░ ▒▓ ░▒▓░
//    ▒ ░ ░    ▒   ▒▒ ░▓██ ░▒░ ▒░▒   ░   ▒   ▒▒ ░  ░▒ ░ ▒░
//    ░   ░    ░   ▒   ▒ ▒ ░░   ░    ░   ░   ▒     ░░   ░
//      ░          ░  ░░ ░      ░            ░  ░   ░
//                     ░ ░           ░
{
  "layer": "top",
  "spacing": 2,
  "width": "",
  "height": "",
  "margin": "0, 6, 0, 6",
  "reload_style_on_change": true,

  "modules-left": [
    "custom/search",
    "wlr/taskbar",
    "hyprland/workspaces",
  ],
  "modules-center": [
    "clock",
    "custom/weather",
  ],
  "modules-right": [
    "tray",
    "group/utilities",
  ],

  "group/utilities": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "battery",
      "custom/power",
    ]
  },

  "custom/power": {
    "format": " ⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "hyprshutdown && poweroff",
      "reboot": "hyprshutdown && reboot",
      "suspend": "hyprlock & sleep 3 && systemctl suspend",
      "logout": "hyprshutdown --vt 2",
      "lock": "hyprlock",
    },
  },

  "custom/notifications": {
    "format": " 󱅫 ",
    "exec": "dunstctl count history",
    "tooltip-format": "{text} notification(s)",
    "exec-if": "exit 0",
  },

  "custom/scrolling": {
    "max-length": 25,
    "align": 0,
    "exec": "~/.config/waybar/scripts/scroll-title.sh",
    "return-type": "plain",
    "format": "{}",
  },

  "custom/weather": {
    //first fetch location using ipinfo.io, then fetch weather with wttr.in
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "plain",
    "format": "{}",
    "interval": 1800,
    "tooltip": false,
    "on-click": "xdg-open 'https://duckduckgo.com/?q=weather'",
  },

  "custom/pacman": {
    "format": "  ",
    "exec": "checkupdates | wc -l",
    "tooltip-format": "{text} update(s) available",
    "exec-if": "exit 0",
  },

  "custom/search": {
    "format": " Search",
    "on-click": "rofi -show drun"
  },

  "custom/menu": {
    "format": " 󰍜 "
  },

  "wlr/taskbar": {
    "icon-size": 20,
    "on-click": "activate",
  },

  "tray": {
    "reverse-direction": true,
    "spacing": 5,
    "icon-size": 20,
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "empty": "",
      "default": "",
      "active": "",
      "special": "",
    },
    "persistent-workspaces": {
      "*": 5,
    },
    "show-special": true,
    "special-visible-only": true,
  },

  "battery": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery!'",
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂄", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "format-full": "󰂄 {capacity}%",
    "tooltip": true,
    "tooltip-format": "Discharging:\n{time} Remaining.",
    "tooltip-format-charging": "Charging:\n{time} Until Full.",
    "tooltip-format-full": "Finished Charging.",
  },

  "clock": {
    "format": " {:%b %d, %H:%M}",
    "on-click": "xdg-open 'https://calendar.proton.me'",
    "timezone-tooltip-format": " {:%H:%M(%Z)} ",
    "timezones": [
      "",
      "UTC",
      "US/Central"
    ],
    "tooltip": true,
    "tooltip-format": "{tz_list}",
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon} ",
    "format-bluetooth": "{icon} ",
    "format-muted": "",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    "tooltip-format": "{desc}\nVolume: {volume}%",
    "on-click": "pavucontrol",
  },

}
