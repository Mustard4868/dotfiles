* {
    bg-col:  #1e1e2e90;
    bg-col-light: #1e1e2e;
    translucent: #00000000;
    border-col: #cba6f7;
    selected-col: #1e1e2e;
    blue: #89b4fa;
    mauve: #cba6f7;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;
    text: #cdd6f4;
    base: #1e1e2e;
    font: "Noto Sans Mono SemiBold 14";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    width: 275px;
    height: 500px;
    border: 3px;
    border-color: @border-col;
    border-radius: 20px;
    background-color: @bg-col;
    location: west;
    x-offset: 24px;
    y-offset: 0px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @translucent;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @mauve;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 20px;
    margin: 20px 0px 0px 20px;
    text-color: @base;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @text;
    background-color: @translucent;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 1;
    lines: 5;
    background-color: @translucent;
}

element {
    padding: 5px;
    background-color: @translucent;
    text-color: @fg-col;
}

element-icon {
    size: 30px;
}

element selected {
    text-color: @fg-col2  ;
}

mode-switcher {
    spacing: 0;
  }

button {
    padding: 10px;
    text-color: @text;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
  text-color: @mauve;
}

message {
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 20px 0px 0px 20px;
    text-color: @blue;
}
